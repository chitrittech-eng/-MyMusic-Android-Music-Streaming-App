# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/
**/build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ / Android Studio
.idea/
*.iml
*.iws
*.ipr
.DS_Store

# Keystore files (VERY IMPORTANT - keep secrets out of VCS)
*.jks
*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild/
.cxx/

# Google Services (e.g. google-services.json)
# Uncomment below if you want to exclude — keep commented to include it
# google-services.json

# Credentials / secret files
secrets.properties
api_keys.properties

# Kotlin
*.kotlin_module

# Test results
test-results/

# macOS
.DS_Store

